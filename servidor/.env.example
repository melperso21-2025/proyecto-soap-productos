# Copiar este archivo como ".env" y completar con los datos reales del proyecto Supabase.
# El ".env" real NUNCA se sube a GitHub (ver .gitignore).

# Panel de Supabase > Project Settings > Data API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Panel de Supabase > Project Settings > API Keys > anon / public
# (para este proyecto academico basta con la anon key + políticas RLS abiertas a lectura/escritura)
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto donde escucha el servidor SOAP
PORT=8000
