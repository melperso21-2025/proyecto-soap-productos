<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- front/ es un proyecto ASP.NET Core propio (Front.csproj) con su
         propio SDK web: sin este exclude, el glob por defecto de este
         .csproj de consola tambien intenta compilar sus .cshtml.cs. -->
    <Compile Remove="front/**" />
    <Content Remove="front/**" />
    <None Remove="front/**" />
  </ItemGroup>
</Project>